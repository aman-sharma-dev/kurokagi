{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kurokagi.invalid/schemas/retest-result-v1.json",
  "title": "Kurokagi Retest Result v1",
  "type": "object",
  "required": ["schema_version", "results"],
  "properties": {
    "schema_version": {"const": "1"},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_version", "source_fingerprint", "outcome", "reason_code", "started_at", "finished_at", "completion_state"],
        "properties": {
          "schema_version": {"const": "1"},
          "source_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "current_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "outcome": {"enum": ["STILL_PRESENT", "FIXED", "INCONCLUSIVE", "NOT_TESTABLE"]},
          "classification": {"type": "string"},
          "operation": {"type": "string"},
          "method": {"type": "string"},
          "current_expectation": {"enum": ["ALLOWED", "DENIED", "UNKNOWN"]},
          "verification_summary": {"type": "string"},
          "reason_code": {"type": "string"},
          "started_at": {"type": "string", "format": "date-time"},
          "finished_at": {"type": "string", "format": "date-time"},
          "completion_state": {"enum": ["complete", "partial", "cancelled"]},
          "cleanup_state": {"type": "string"},
          "cleanup_required": {"type": "boolean"},
          "cleanup_attempted": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
